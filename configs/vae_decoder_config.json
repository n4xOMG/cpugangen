{
  "model": {
    "base_channels": 64,
    "max_channels": 256,
    "num_upsample_blocks": 3,
    "comment": "Lightweight decoder: ~2-5M params vs 49M in SDXL VAE"
  },
  "data": {
    "train_latent_metadata": "data/cached_latents/train/latent_metadata.json",
    "train_latents_dir": "data/cached_latents/train/latents",
    "train_images_dir": "data/processed_images/train",
    "train_masks_dir": null,
    "val_latent_metadata": "data/cached_latents/val/latent_metadata.json",
    "val_latents_dir": "data/cached_latents/val/latents",
    "val_images_dir": "data/processed_images/val",
    "val_masks_dir": null,
    "resolution": 1024,
    "comment": "Set masks_dir if using pad strategy. Leave null otherwise."
  },
  "training": {
    "num_epochs": 20,
    "batch_size": 8,
    "learning_rate": 1e-4,
    "weight_decay": 0.01,
    "max_grad_norm": 1.0,
    "num_workers": 4,
    "save_every": 5,
    "output_dir": "checkpoints/tiny_vae",
    "comment": "Batch size 8 should work on 24GB GPU. Adjust as needed."
  },
  "loss": {
    "l1_weight": 1.0,
    "l2_weight": 0.5,
    "use_perceptual": false,
    "comment": "L1 for sharpness, L2 for smoothness. Perceptual loss optional (requires VGG)."
  },
  "logging": {
    "use_wandb": true,
    "wandb_project": "tiny-vae-training",
    "run_name": "tinyvae-anime-v1",
    "log_every": 50
  }
}
